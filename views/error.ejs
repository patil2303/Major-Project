<%- layout("/layouts/boilerplate") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      
      <div class="glass-form-card text-center py-5 shadow-lg">
        <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 64px; height: 64px; font-size: 1.75rem;">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h2 class="h4 fw-bold text-dark mb-2">Something Went Wrong</h2>
        <p class="text-muted mb-4"><%= (typeof message !== 'undefined' && message) ? message : 'An unexpected error occurred while processing your request.' %></p>
        
        <div class="d-flex justify-content-center gap-2">
          <a href="/listings" class="btn-brand-solid px-4">
            <i class="fa-solid fa-house me-1"></i> Return to Explorer
          </a>
          <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4">
            Go Back
          </a>
        </div>
      </div>

    </div>
  </div>
</div>