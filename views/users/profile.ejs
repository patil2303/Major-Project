<%- layout("/layouts/boilerplate") %>

<% 
  var u = (typeof user !== 'undefined' && user) ? user : (typeof currUser !== 'undefined' ? currUser : null);
  var w = (typeof wallet !== 'undefined' && wallet) ? wallet : (typeof locals !== 'undefined' && locals.wallet ? locals.wallet : null);
%>

<div class="container py-4">
  <!-- Profile Header Banner -->
  <div class="glossy-panel p-4 mb-4 shadow-sm">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
      <div class="d-flex align-items-center gap-3">
        <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center shadow-sm fw-bold fs-3" style="width: 72px; height: 72px;">
          <%= u ? u.username.charAt(0).toUpperCase() : 'U' %>
        </div>
        <div>
          <h2 class="h4 fw-bold text-dark mb-0"><%= u ? u.username : 'Traveler' %></h2>
          <div class="text-muted small">
            <i class="fa-solid fa-envelope me-1"></i> <%= u ? u.email : 'user@homigo.com' %> 
            <% if (u && u.phoneNumber) { %>
              • <i class="fa-solid fa-phone me-1"></i> <%= u.phoneNumber %>
            <% } %>
          </div>
          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 small mt-2">
            <i class="fa-solid fa-shield-check me-1"></i> Verified Homigo Member
          </span>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="d-flex gap-2">
        <a href="/bookings" class="btn-host-action small">
          <i class="fa-solid fa-calendar-check text-primary me-1"></i> My Bookings
        </a>
        <a href="/wallet" class="btn-host-action small">
          <i class="fa-solid fa-wallet text-warning me-1"></i> Wallet
        </a>
        <a href="/listings/new" class="btn-brand-solid btn-sm">
          <i class="fa-solid fa-plus me-1"></i> Host a Stay
        </a>
      </div>
    </div>
  </div>

  <!-- User Details & Stats Grid -->
  <div class="row g-4">
    <!-- Left Column: Account Details -->
    <div class="col-lg-6">
      <div class="glossy-panel p-4 h-100">
        <h4 class="h6 fw-bold mb-3 text-dark"><i class="fa-solid fa-id-card text-danger me-2"></i>Account Details</h4>
        
        <div class="mb-3">
          <label class="form-label-custom small text-muted">USERNAME</label>
          <div class="p-2 rounded bg-light border text-dark fw-semibold small"><%= u ? u.username : 'N/A' %></div>
        </div>

        <div class="mb-3">
          <label class="form-label-custom small text-muted">EMAIL ADDRESS</label>
          <div class="p-2 rounded bg-light border text-dark fw-semibold small"><%= u ? u.email : 'N/A' %></div>
        </div>

        <div class="mb-3">
          <label class="form-label-custom small text-muted">PHONE NUMBER</label>
          <div class="p-2 rounded bg-light border text-dark fw-semibold small"><%= (u && u.phoneNumber) ? u.phoneNumber : '+91 98765 43210' %></div>
        </div>

        <div class="mb-0">
          <label class="form-label-custom small text-muted">MEMBERSHIP STATUS</label>
          <div class="p-2 rounded bg-light border text-dark fw-semibold small">Active • Premium Guest Tier</div>
        </div>
      </div>
    </div>

    <!-- Right Column: Wallet & Rewards Overview -->
    <div class="col-lg-6">
      <div class="glossy-panel p-4 h-100">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h4 class="h6 fw-bold mb-0 text-dark"><i class="fa-solid fa-coins text-warning me-2"></i>Homigo Wallet & Perks</h4>
          <a href="/wallet" class="small text-danger fw-semibold text-decoration-none">Manage Wallet &rarr;</a>
        </div>

        <!-- Wallet Card Visual -->
        <div class="p-4 rounded-4 text-white mb-3" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); box-shadow: 0 10px 25px rgba(15, 23, 42, 0.25);">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="small text-white-50"><i class="fa-solid fa-compass text-danger me-1"></i> Homigo Travel Pass</span>
            <span class="badge bg-warning text-dark font-monospace fw-bold">GOLD</span>
          </div>
          <div class="fs-2 fw-bold mb-1">&#8377; <%= (w && w.coins) ? (w.coins * 10).toLocaleString('en-IN') : '5,000' %></div>
          <div class="small text-white-50"><%= (w && w.coins) ? w.coins : '500' %> Homigo Coins Available</div>
        </div>

        <div class="row g-2">
          <div class="col-6">
            <a href="/bookings" class="d-block p-3 rounded-3 bg-light border text-decoration-none text-dark text-center">
              <i class="fa-solid fa-calendar-days fs-4 text-primary mb-1 d-block"></i>
              <span class="fw-bold small d-block">My Trips</span>
              <span class="text-muted" style="font-size: 0.75rem;">View active bookings</span>
            </a>
          </div>
          <div class="col-6">
            <a href="/listings" class="d-block p-3 rounded-3 bg-light border text-decoration-none text-dark text-center">
              <i class="fa-solid fa-heart fs-4 text-danger mb-1 d-block"></i>
              <span class="fw-bold small d-block">Saved Stays</span>
              <span class="text-muted" style="font-size: 0.75rem;">Explore 50+ stays</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
