<%- layout("/layouts/boilerplate") %>

<div class="container py-4">
  <!-- Header -->
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1"><i class="fa-solid fa-suitcase-rolling text-danger me-2"></i>My Reservations</h1>
      <p class="text-muted small mb-0">Review your past stays and upcoming itineraries across India.</p>
    </div>
    <a href="/listings" class="btn-brand-solid btn-sm">
      <i class="fa-solid fa-magnifying-glass me-1"></i> Discover More Stays
    </a>
  </div>

  <% if (bookings && bookings.length > 0) { %>
    <div class="row g-4">
      <% for (let booking of bookings) { 
           const checkInDate = new Date(booking.checkIn);
           const checkOutDate = new Date(booking.checkOut);
           const nights = Math.max(1, Math.ceil((checkOutDate - checkInDate) / (1000 * 60 * 60 * 24)));
      %>
        <div class="col-12">
          <div class="glossy-panel p-3 p-md-4 shadow-sm">
            <div class="row g-4 align-items-center">
              
              <!-- Property Thumbnail Image -->
              <div class="col-md-3">
                <div class="rounded-3 overflow-hidden shadow-sm position-relative" style="height: 180px;">
                  <% if (booking.listing && booking.listing.image && booking.listing.image.url) { %>
                    <img src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>" class="w-100 h-100 object-fit-cover">
                  <% } else if (booking.listing && booking.listing.images && booking.listing.images.length > 0) { %>
                    <img src="<%= booking.listing.images[0].url || booking.listing.images[0] %>" alt="<%= booking.listing.title %>" class="w-100 h-100 object-fit-cover">
                  <% } else { %>
                    <div class="w-100 h-100 bg-secondary-subtle d-flex align-items-center justify-content-center text-muted">
                      <i class="fa-solid fa-image fs-3"></i>
                    </div>
                  <% } %>
                  <span class="badge bg-white text-dark position-absolute top-0 start-0 m-2 shadow-sm rounded-pill px-2 py-1 small">
                    <i class="fa-solid fa-hotel text-danger me-1"></i> Confirmed
                  </span>
                </div>
              </div>

              <!-- Booking Details -->
              <div class="col-md-6">
                <% if (booking.listing) { %>
                  <h3 class="h5 fw-bold text-dark mb-1">
                    <a href="/listings/<%= booking.listing._id %>" class="text-decoration-none text-dark hover-danger">
                      <%= booking.listing.title %>
                    </a>
                  </h3>
                  <div class="text-muted small mb-3">
                    <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= booking.listing.location %>, <%= booking.listing.country %>
                  </div>

                  <div class="row g-2 text-dark small mb-2">
                    <div class="col-6">
                      <span class="text-muted d-block" style="font-size: 0.75rem;">CHECK-IN</span>
                      <span class="fw-semibold"><i class="fa-regular fa-calendar me-1 text-primary"></i> <%= checkInDate.toLocaleDateString("en-IN", { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                    </div>
                    <div class="col-6">
                      <span class="text-muted d-block" style="font-size: 0.75rem;">CHECK-OUT</span>
                      <span class="fw-semibold"><i class="fa-regular fa-calendar-check me-1 text-success"></i> <%= checkOutDate.toLocaleDateString("en-IN", { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                    </div>
                  </div>

                  <div class="text-muted small">
                    Duration: <strong class="text-dark"><%= nights %> night<%= nights > 1 ? 's' : '' %></strong> • Host: <strong class="text-dark"><%= booking.listing.owner?.username || "homigo_host" %></strong>
                  </div>
                <% } else { %>
                  <h4 class="h5 text-muted">Listing information unavailable</h4>
                <% } %>
              </div>

              <!-- Total & Actions -->
              <div class="col-md-3 text-md-end border-start-md pt-3 pt-md-0">
                <div class="text-muted small">Total Paid</div>
                <div class="fs-4 fw-bold text-danger mb-3">&#8377; <%= (booking.totalPrice || (booking.listing ? booking.listing.price * nights : 5000)).toLocaleString('en-IN') %></div>

                <div class="d-flex flex-md-column gap-2 justify-content-end">
                  <% if (booking.listing) { %>
                    <a href="/listings/<%= booking.listing._id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                      View Stay Details
                    </a>
                  <% } %>
                  <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="window.print();">
                    <i class="fa-solid fa-receipt me-1"></i> Receipt
                  </button>
                </div>
              </div>

            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <!-- Empty State -->
    <div class="glass-form-card text-center py-5 my-4 mx-auto" style="max-width: 580px;">
      <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; font-size: 1.75rem;">
        <i class="fa-solid fa-calendar-xmark"></i>
      </div>
      <h3 class="h4 fw-bold mb-2">No active bookings yet</h3>
      <p class="text-muted mb-4">When you book an escape on Homigo, your reservations and itineraries will appear right here.</p>
      <a href="/listings" class="btn-brand-solid">Start Exploring 50+ Stays</a>
    </div>
  <% } %>

</div>
