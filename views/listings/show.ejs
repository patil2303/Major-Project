<%- layout("/layouts/boilerplate") %>

<!-- Injected script variables for Map and Gallery -->
<script>
  const mapToken = "<%= process.env.MAP_TOKEN || '' %>";
  const googleMapsApiKey = "<%= process.env.GOOGLE_MAPS_API_KEY || '' %>";
  const listing = <%- JSON.stringify(listing) %>;
  const galleryImages = <%- JSON.stringify(galleryImages || []) %>;
</script>

<div class="container-fluid px-lg-5 py-4">

  <!-- Breadcrumb Navigation -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0 small">
      <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Home</a></li>
      <li class="breadcrumb-item"><a href="/listings" class="text-decoration-none text-muted">Stays</a></li>
      <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page"><%= listing.title %></li>
    </ol>
  </nav>

  <!-- Title & Actions Bar -->
  <div class="d-flex flex-column flex-md-row md-align-items-center justify-content-between gap-3 mb-4">
    <div>
      <h1 class="h2 fw-bold text-dark mb-1"><%= listing.title %></h1>
      <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
        <span class="fw-semibold text-dark">
          <i class="fa-solid fa-star text-warning me-1"></i> 4.95
          <span class="text-muted fw-normal">(<%= listing.reviews.length %> reviews)</span>
        </span>
        <span>•</span>
        <span class="fw-semibold text-danger">
          <i class="fa-solid fa-award me-1"></i> Superhost
        </span>
        <span>•</span>
        <span>
          <i class="fa-solid fa-location-dot text-danger me-1"></i> <%= listing.location %>, <%= listing.country %>
        </span>
      </div>
    </div>

    <!-- Top Action Buttons -->
    <div class="d-flex align-items-center gap-2">
      <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied to clipboard!');">
        <i class="fa-solid fa-arrow-up-from-bracket me-1"></i> Share
      </button>
      <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="this.classList.toggle('active'); this.querySelector('i').classList.toggle('fa-solid');">
        <i class="fa-regular fa-heart me-1"></i> Save
      </button>
    </div>
  </div>

  <!-- Bento 4-Photo Gallery Grid -->
  <div class="row g-2 mb-5 rounded-4 overflow-hidden shadow-sm" style="max-height: 460px;">
    <!-- Main Big Photo (Left) -->
    <div class="col-12 col-md-7 position-relative" style="height: 460px;">
      <img src="<%= (galleryImages && galleryImages[0] && galleryImages[0].url) ? galleryImages[0].url : '/images/placeholder.jpg' %>" 
           alt="<%= listing.title %>"
           class="w-100 h-100 object-fit-cover rounded-start-4 cursor-pointer"
           style="cursor: pointer; transition: transform 0.4s ease;"
           onclick="openPhotoModal(); showPhoto(0);">
    </div>

    <!-- Secondary Photos Grid (Right) -->
    <div class="col-12 col-md-5 d-none d-md-block" style="height: 460px;">
      <div class="row g-2 h-100">
        <% if (galleryImages && galleryImages.length > 1) { %>
          <% galleryImages.slice(1, 4).forEach(function(img, idx) { %>
            <div class="<%= idx === 0 ? 'col-12' : 'col-6' %>" style="height: <%= idx === 0 ? '226px' : '226px' %>;">
              <img src="<%= img.url %>" 
                   alt="Gallery photo <%= idx + 2 %>"
                   class="w-100 h-100 object-fit-cover <%= idx === 0 ? 'rounded-top-end-4' : (idx === 2 ? 'rounded-bottom-end-4' : '') %>"
                   style="cursor: pointer; transition: transform 0.4s ease;"
                   onclick="openPhotoModal(); showPhoto(<%= idx + 1 %>);">
            </div>
          <% }); %>
        <% } else { %>
          <div class="col-12 h-100">
            <img src="<%= (galleryImages && galleryImages[0] && galleryImages[0].url) ? galleryImages[0].url : '/images/placeholder.jpg' %>" 
                 class="w-100 h-100 object-fit-cover rounded-end-4">
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Main Content Layout (Left Details + Right Sticky Booking) -->
  <div class="row g-5">
    
    <!-- Left Column: Details, Amenities, Map, Reviews -->
    <div class="col-lg-8">
      
      <!-- Host & Property Specs Card -->
      <div class="glossy-panel p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between pb-4 border-bottom">
          <div>
            <h3 class="h5 fw-bold mb-1">Entire villa hosted by <%= listing.owner.username %></h3>
            <p class="text-muted small mb-0">6 guests • 3 bedrooms • 3 beds • 3 private bathrooms</p>
          </div>
          <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center shadow-sm fw-bold" style="width: 52px; height: 52px; font-size: 1.3rem;">
            <%= listing.owner.username.charAt(0).toUpperCase() %>
          </div>
        </div>

        <!-- Pillars of Stay -->
        <div class="row g-3 py-4 border-bottom">
          <div class="col-md-4 d-flex align-items-start gap-3">
            <i class="fa-solid fa-door-open fs-4 text-danger mt-1"></i>
            <div>
              <div class="fw-bold small">Self check-in</div>
              <div class="text-muted" style="font-size: 0.8rem;">Check yourself in with the smart keypad.</div>
            </div>
          </div>
          <div class="col-md-4 d-flex align-items-start gap-3">
            <i class="fa-solid fa-medal fs-4 text-danger mt-1"></i>
            <div>
              <div class="fw-bold small">Experienced Superhost</div>
              <div class="text-muted" style="font-size: 0.8rem;"><%= listing.owner.username %> has 100% 5-star ratings.</div>
            </div>
          </div>
          <div class="col-md-4 d-flex align-items-start gap-3">
            <i class="fa-solid fa-calendar-xmark fs-4 text-danger mt-1"></i>
            <div>
              <div class="fw-bold small">Free cancellation</div>
              <div class="text-muted" style="font-size: 0.8rem;">Cancel up to 48 hours before check-in.</div>
            </div>
          </div>
        </div>

        <!-- Description -->
        <div class="pt-4">
          <h4 class="h6 fw-bold mb-3">About this space</h4>
          <p class="text-secondary leading-relaxed mb-0" style="font-size: 0.95rem; line-height: 1.75;">
            <%= listing.description %>
          </p>
        </div>
      </div>

      <!-- Amenities Section -->
      <div class="glossy-panel p-4 mb-4">
        <h4 class="h6 fw-bold mb-3">What this place offers</h4>
        <div class="row row-cols-1 row-cols-sm-2 g-3">
          <div class="col d-flex align-items-center gap-3 text-dark">
            <i class="fa-solid fa-wifi fs-5 text-muted" style="width: 24px;"></i>
            <span>High-speed WiFi (100+ Mbps)</span>
          </div>
          <div class="col d-flex align-items-center gap-3 text-dark">
            <i class="fa-solid fa-snowflake fs-5 text-muted" style="width: 24px;"></i>
            <span>Air conditioning & heating</span>
          </div>
          <div class="col d-flex align-items-center gap-3 text-dark">
            <i class="fa-solid fa-utensils fs-5 text-muted" style="width: 24px;"></i>
            <span>Dedicated chef & kitchen</span>
          </div>
          <div class="col d-flex align-items-center gap-3 text-dark">
            <i class="fa-solid fa-square-parking fs-5 text-muted" style="width: 24px;"></i>
            <span>Free private parking on premises</span>
          </div>
          <div class="col d-flex align-items-center gap-3 text-dark">
            <i class="fa-solid fa-mountain-sun fs-5 text-muted" style="width: 24px;"></i>
            <span>Scenic panoramic vistas</span>
          </div>
          <div class="col d-flex align-items-center gap-3 text-dark">
            <i class="fa-solid fa-tv fs-5 text-muted" style="width: 24px;"></i>
            <span>55" 4K Smart TV with Netflix</span>
          </div>
        </div>
      </div>

      <!-- Google Maps Section -->
      <div class="glossy-panel p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <h4 class="h6 fw-bold mb-1"><i class="fa-solid fa-map-location-dot text-danger me-2"></i>Where you'll be</h4>
            <p class="text-muted small mb-0"><%= listing.location %>, <%= listing.country %></p>
          </div>
          <span class="glossy-pill px-3 py-1 small fw-semibold text-muted">
            <i class="fa-brands fa-google text-primary me-1"></i> Google Maps Verified
          </span>
        </div>
        <div id="map" class="rounded-4 border overflow-hidden shadow-sm" style="height: 380px; width: 100%;"></div>
      </div>

      <!-- Reviews & Feedback -->
      <div class="glossy-panel p-4 mb-4">
        <div class="d-flex align-items-center gap-2 mb-4">
          <i class="fa-solid fa-star text-warning fs-4"></i>
          <h3 class="h5 fw-bold mb-0">4.95 • <%= listing.reviews.length %> Reviews</h3>
        </div>

        <!-- Add Review Form (Logged in users) -->
        <% if (currUser) { %>
          <div class="p-3 rounded-3 mb-4 bg-light-subtle border">
            <h5 class="h6 fw-bold mb-3">Leave a Review</h5>
            <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
              <div class="mb-3">
                <label class="form-label-custom small">Your Overall Rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="5" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>
              <div class="mb-3">
                <label for="comment" class="form-label-custom small">Share your experience</label>
                <textarea name="review[comment]" id="comment" rows="3" class="form-control glass-input" placeholder="Tell future guests about the host, amenities, and location..." required></textarea>
                <div class="invalid-feedback">Please write a short comment.</div>
              </div>
              <button type="submit" class="btn-brand-solid btn-sm">
                <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
              </button>
            </form>
          </div>
        <% } %>

        <!-- Reviews List -->
        <% if (listing.reviews.length > 0) { %>
          <div class="row row-cols-1 row-cols-md-2 g-3">
            <% for (review of listing.reviews) { %>
              <div class="col">
                <div class="p-3 rounded-3 bg-white border h-100 d-flex flex-column justify-content-between">
                  <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-secondary-subtle text-dark d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                          <%= review.author.username.charAt(0).toUpperCase() %>
                        </div>
                        <div>
                          <div class="fw-bold small"><%= review.author.username %></div>
                          <div class="text-muted" style="font-size: 0.75rem;">Verified Guest</div>
                        </div>
                      </div>
                      <p class="starability-result mb-0" data-rating="<%= review.rating %>"></p>
                    </div>
                    <p class="text-secondary small mb-2"><%= review.comment %></p>
                  </div>

                  <% if (currUser && (currUser._id.equals(review.author._id) || currUser._id.equals(listing.owner._id))) { %>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="text-end">
                      <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none small">
                        <i class="fa-solid fa-trash me-1"></i> Delete
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <p class="text-muted text-center py-3 mb-0"><em>No reviews yet. Be the first to review this extraordinary stay!</em></p>
        <% } %>

      </div>

      <!-- Host Controls (Owner Edit / Delete) -->
      <% if (currUser && listing.owner._id.equals(currUser._id)) { %>
        <div class="glossy-panel p-4 mb-4 border-warning">
          <h5 class="h6 fw-bold mb-2 text-dark"><i class="fa-solid fa-crown text-warning me-2"></i>Host Administration</h5>
          <p class="text-muted small mb-3">You are the owner of this property. Manage your listing details or remove it from Homigo.</p>
          <div class="d-flex gap-2">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark rounded-pill px-4 btn-sm">
              <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
            </a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing?');">
              <button class="btn btn-danger rounded-pill px-4 btn-sm">
                <i class="fa-solid fa-trash me-1"></i> Delete Stay
              </button>
            </form>
          </div>
        </div>
      <% } %>

    </div>

    <!-- Right Column: Sticky Booking Widget -->
    <div class="col-lg-4">
      <div class="position-sticky" style="top: 6.5rem; z-index: 50;">
        <%- include("../includes/booking-card") %>
      </div>
    </div>

  </div>

</div>

<!-- Photo Lightbox Modal -->
<div id="photoModal" class="modal fade" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content glossy-panel border-0 p-3">
      <div class="modal-header border-0 pb-0">
        <span class="fw-bold small text-muted"><span id="currentPhotoNum">1</span> / <span id="totalPhotosNum"><%= galleryImages.length || 1 %></span></span>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center p-2">
        <img id="modalFullImg" src="" class="img-fluid rounded-3 shadow" style="max-height: 70vh; object-fit: contain;">
      </div>
      <div class="modal-footer border-0 pt-0 justify-content-between">
        <button class="btn btn-sm btn-outline-secondary rounded-pill" onclick="changePhoto(-1)">
          <i class="fa-solid fa-arrow-left"></i> Previous
        </button>
        <button class="btn btn-sm btn-outline-secondary rounded-pill" onclick="changePhoto(1)">
          Next <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let activeIndex = 0;
  let photoModalInstance = null;

  function openPhotoModal() {
    const modalEl = document.getElementById('photoModal');
    if (!photoModalInstance) {
      photoModalInstance = new bootstrap.Modal(modalEl);
    }
    photoModalInstance.show();
  }

  function showPhoto(idx) {
    if (!galleryImages || galleryImages.length === 0) return;
    activeIndex = Math.max(0, Math.min(idx, galleryImages.length - 1));
    const target = galleryImages[activeIndex] || galleryImages[0];
    document.getElementById('modalFullImg').src = target.url || target;
    document.getElementById('currentPhotoNum').textContent = activeIndex + 1;
    document.getElementById('totalPhotosNum').textContent = galleryImages.length;
    openPhotoModal();
  }

  function changePhoto(direction) {
    if (!galleryImages || galleryImages.length === 0) return;
    let next = activeIndex + direction;
    if (next < 0) next = galleryImages.length - 1;
    if (next >= galleryImages.length) next = 0;
    showPhoto(next);
  }
</script>

<!-- Google Maps JS Loader -->
<script src="/js/map.js"></script>