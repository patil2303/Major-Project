<%- layout("/layouts/boilerplate") %>

<div class="container-fluid px-lg-5 py-3">

  <!-- Explorer Header & Category Filters -->
  <div class="filter-bar-wrap">
    <!-- Category Pills -->
    <div class="category-pills-list">
      <a href="/listings" class="cat-pill <%= (!category || category === 'all') ? 'active' : '' %>">
        <i class="fa-solid fa-border-all"></i> All Stays
      </a>
      <a href="/listings?category=trending" class="cat-pill <%= category==='trending' ? 'active' : '' %>">
        <i class="fa-solid fa-fire text-danger"></i> Trending
      </a>
      <a href="/listings?category=iconic" class="cat-pill <%= category==='iconic' ? 'active' : '' %>">
        <i class="fa-solid fa-landmark"></i> Heritage
      </a>
      <a href="/listings?category=views" class="cat-pill <%= category==='views' ? 'active' : '' %>">
        <i class="fa-solid fa-mountain-sun"></i> Mountain Views
      </a>
      <a href="/listings?category=beach" class="cat-pill <%= category==='beach' ? 'active' : '' %>">
        <i class="fa-solid fa-umbrella-beach"></i> Beachfront
      </a>
      <a href="/listings?category=pools" class="cat-pill <%= category==='pools' ? 'active' : '' %>">
        <i class="fa-solid fa-water-ladder"></i> Pools & Villas
      </a>
      <a href="/listings?category=cabins" class="cat-pill <%= category==='cabins' ? 'active' : '' %>">
        <i class="fa-solid fa-tree"></i> Pine Cabins
      </a>
      <a href="/listings?category=farms" class="cat-pill <%= category==='farms' ? 'active' : '' %>">
        <i class="fa-solid fa-seedling"></i> Tea & Coffee Estates
      </a>
    </div>

    <!-- Tax Toggle Switch -->
    <div class="tax-toggle-pill d-none d-md-inline-flex" id="taxToggleBtn">
      <span class="text-muted small">Display total after GST</span>
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch" style="cursor: pointer;">
      </div>
    </div>
  </div>

  <!-- Listings Result Count & Current Filter Notice -->
  <div class="d-flex align-items-center justify-content-between mb-4 px-1">
    <div>
      <h2 class="h4 mb-0 fw-bold">
        <% if (typeof search !== 'undefined' && search) { %>
          Stays in "<%= search %>"
        <% } else if (category && category !== 'all') { %>
          <%= category.charAt(0).toUpperCase() + category.slice(1) %> Stays in India
        <% } else { %>
          Explore Stays Across India
        <% } %>
      </h2>
      <p class="text-muted small mb-0"><%= allListings.length %> verified destinations available</p>
    </div>

    <% if ((typeof search !== 'undefined' && search) || (category && category !== 'all')) { %>
      <a href="/listings" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
        <i class="fa-solid fa-rotate-left me-1"></i> Clear Filters
      </a>
    <% } %>
  </div>

  <!-- Listings Grid -->
  <% if (allListings.length === 0) { %>
    <div class="glass-form-card text-center py-5 my-4 mx-auto" style="max-width: 580px;">
      <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; font-size: 1.75rem;">
        <i class="fa-solid fa-map-location-dot"></i>
      </div>
      <h3 class="h4 fw-bold mb-2">No stays found for this search</h3>
      <p class="text-muted mb-4">Try searching for other popular regions like Goa, Jaipur, Manali, Kerala, or Ladakh.</p>
      <a href="/listings" class="btn-brand-solid">Explore All 50 Stays</a>
    </div>
  <% } else { %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
      <% for (let listing of allListings) { %>
        <div class="col">
          <a href="/listings/<%= listing._id %>" class="stay-card-link">
            <div class="homigo-card">
              <!-- Image Container -->
              <div class="card-img-container">
                <img src="<%= (listing.image && listing.image.url) ? listing.image.url : (listing.images && listing.images.length ? (listing.images[0].url || listing.images[0]) : '/images/placeholder.jpg') %>" 
                     alt="<%= listing.title %>"
                     loading="lazy">
                
                <span class="card-badge-top">
                  <i class="fa-solid fa-sparkles text-danger me-1"></i> <%= (listing.category ? listing.category.toUpperCase() : 'INDIA') %>
                </span>

                <button type="button" class="card-heart-btn" onclick="event.preventDefault(); this.querySelector('i').classList.toggle('fa-solid'); this.querySelector('i').classList.toggle('text-danger');">
                  <i class="fa-regular fa-heart"></i>
                </button>
              </div>

              <!-- Content -->
              <div class="card-content">
                <div>
                  <div class="d-flex align-items-start justify-content-between gap-2 mb-1">
                    <h3 class="card-title-text" title="<%= listing.title %>"><%= listing.title %></h3>
                    <div class="card-rating-badge">
                      <i class="fa-solid fa-star"></i>
                      <span>4.95</span>
                    </div>
                  </div>
                  <div class="card-loc-text">
                    <i class="fa-solid fa-location-dot text-danger small"></i>
                    <span><%= listing.location %>, <%= listing.country %></span>
                  </div>
                </div>

                <div class="card-price-row">
                  <div class="card-price-val">
                    <span class="base-price">&#8377; <%= listing.price.toLocaleString("en-IN") %></span>
                    <span class="tax-price d-none">&#8377; <%= Math.round(listing.price * 1.18).toLocaleString("en-IN") %></span>
                    <small>/ night</small>
                  </div>
                  <span class="text-muted small tax-label d-none">+18% GST incl.</span>
                </div>
              </div>
            </div>
          </a>
        </div>
      <% } %>
    </div>
  <% } %>

</div>

<script>
  // GST Tax Switch Handler
  const taxSwitch = document.getElementById('taxSwitch');
  if (taxSwitch) {
    taxSwitch.addEventListener('change', function() {
      const basePrices = document.querySelectorAll('.base-price');
      const taxPrices = document.querySelectorAll('.tax-price');
      const taxLabels = document.querySelectorAll('.tax-label');

      if (this.checked) {
        basePrices.forEach(el => el.classList.add('d-none'));
        taxPrices.forEach(el => el.classList.remove('d-none'));
        taxLabels.forEach(el => el.classList.remove('d-none'));
      } else {
        basePrices.forEach(el => el.classList.remove('d-none'));
        taxPrices.forEach(el => el.classList.add('d-none'));
        taxLabels.forEach(el => el.classList.add('d-none'));
      }
    });
  }
</script>
