<%- layout("/layouts/boilerplate") %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      
      <!-- Modern Glass Listing Edit Form -->
      <div class="glass-form-card shadow-lg">
        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
          <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.25rem;">
            <i class="fa-solid fa-pen-to-square"></i>
          </div>
          <div>
            <h2 class="h4 fw-bold text-dark mb-0">Edit Listing</h2>
            <p class="text-muted small mb-0">Update pricing, description, photos, and location for <%= listing.title %></p>
          </div>
        </div>

        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">

          <!-- Section 1: Property Details -->
          <div class="mb-4">
            <h5 class="h6 fw-bold text-dark mb-3"><i class="fa-solid fa-circle-info text-danger me-2"></i>General Information</h5>
            
            <div class="mb-3">
              <label for="title" class="form-label-custom">Listing Title</label>
              <input name="listing[title]" id="title" value="<%= listing.title %>" type="text" class="form-control glass-input" required>
              <div class="invalid-feedback">Please enter a valid title.</div>
            </div>

            <div class="mb-3">
              <label for="description" class="form-label-custom">Description</label>
              <textarea name="listing[description]" id="description" rows="4" class="form-control glass-input" required><%= listing.description %></textarea>
              <div class="invalid-feedback">Please provide a description.</div>
            </div>

            <div class="row g-3">
              <div class="col-md-6">
                <label for="category" class="form-label-custom">Primary Category</label>
                <select class="form-select glass-input" name="listing[category]" id="category" required>
                  <option value="iconic" <%= listing.category === 'iconic' ? 'selected' : '' %>>Iconic / Heritage Palace</option>
                  <option value="trending" <%= listing.category === 'trending' ? 'selected' : '' %>>Trending & Modern</option>
                  <option value="beach" <%= listing.category === 'beach' ? 'selected' : '' %>>Beach & Coastal</option>
                  <option value="cabins" <%= listing.category === 'cabins' ? 'selected' : '' %>>Mountain & Pine Cabin</option>
                  <option value="pools" <%= listing.category === 'pools' ? 'selected' : '' %>>Luxury Villa with Pool</option>
                  <option value="farms" <%= listing.category === 'farms' ? 'selected' : '' %>>Tea & Coffee Plantation</option>
                  <option value="views" <%= listing.category === 'views' ? 'selected' : '' %>>Spectacular Mountain Views</option>
                  <option value="room" <%= listing.category === 'room' ? 'selected' : '' %>>Boutique Room / Suite</option>
                </select>
              </div>

              <div class="col-md-6">
                <label for="price" class="form-label-custom">Nightly Price (₹ INR)</label>
                <div class="input-group">
                  <span class="input-group-text bg-white border-end-0 text-muted">₹</span>
                  <input name="listing[price]" id="price" value="<%= listing.price %>" type="number" class="form-control glass-input border-start-0 ps-0" required min="500">
                </div>
                <div class="invalid-feedback">Enter a valid price.</div>
              </div>
            </div>
          </div>

          <!-- Section 2: Photos -->
          <div class="mb-4">
            <h5 class="h6 fw-bold text-dark mb-3"><i class="fa-solid fa-camera text-danger me-2"></i>Update Photographs</h5>
            
            <div class="mb-3">
              <label class="form-label-custom">Current Cover Photo</label>
              <div class="rounded-3 overflow-hidden border mb-2" style="max-width: 240px; height: 140px;">
                <img src="<%= (listing.image && listing.image.url) ? listing.image.url : '/images/placeholder.jpg' %>" class="w-100 h-100 object-fit-cover" alt="Current image">
              </div>
              <input name="listing[image]" id="image" type="file" class="form-control glass-input mb-2" accept="image/*">
              <input name="listing[imageUrl]" id="imageUrl" type="url" class="form-control glass-input" placeholder="Or paste a new cover photo URL">
            </div>

            <div class="mb-3">
              <label for="otherImages" class="form-label-custom">Replace Additional Gallery Photos</label>
              <input name="listing[otherImages]" id="otherImages" type="file" class="form-control glass-input mb-2" multiple accept="image/*">
              <input name="listing[otherImageUrls]" id="otherImageUrls" type="text" class="form-control glass-input" placeholder="Or paste new image URLs separated by commas">
            </div>

            <!-- Live Photo Previews Grid -->
            <div class="p-3 rounded-3 bg-light-subtle border mt-3" id="previewContainer">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="fw-bold small text-dark"><i class="fa-solid fa-images text-danger me-1"></i> Live New Image Previews</span>
                <span class="badge bg-secondary-subtle text-muted" id="previewCountBadge">No new images selected</span>
              </div>

              <div id="previewEmptyState" class="text-center py-3 text-muted small">
                <i class="fa-regular fa-image fs-4 d-block mb-1 opacity-50"></i>
                Select a new cover or gallery photos above to preview how they will look before updating.
              </div>

              <div id="previewGrid" class="row g-2 d-none">
                <div class="col-12 col-sm-6 d-none" id="coverPreviewCol">
                  <div class="card h-100 border-0 shadow-sm overflow-hidden position-relative rounded-3" style="min-height: 180px;">
                    <img id="coverPreviewImg" src="" alt="Cover preview" class="w-100 h-100 object-fit-cover" style="height: 180px;">
                    <span class="badge bg-danger position-absolute top-0 start-0 m-2 shadow-sm rounded-pill px-2 py-1 small">
                      <i class="fa-solid fa-star me-1"></i> New Cover
                    </span>
                    <button type="button" class="btn btn-sm btn-dark position-absolute top-0 end-0 m-2 rounded-circle p-1" style="width:26px; height:26px; line-height:1;" onclick="clearCoverPreview()" title="Clear">
                      &times;
                    </button>
                  </div>
                </div>

                <div class="col-12 col-sm-6">
                  <div class="row g-2" id="galleryPreviewList"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 3: Location -->
          <div class="mb-4">
            <h5 class="h6 fw-bold text-dark mb-3"><i class="fa-solid fa-location-dot text-danger me-2"></i>Location</h5>
            
            <div class="row g-3">
              <div class="col-md-7">
                <label for="location" class="form-label-custom">City & State / Region</label>
                <input name="listing[location]" id="location" value="<%= listing.location %>" type="text" class="form-control glass-input" required>
              </div>

              <div class="col-md-5">
                <label for="country" class="form-label-custom">Country</label>
                <input name="listing[country]" id="country" value="<%= listing.country %>" type="text" class="form-control glass-input" required>
              </div>
            </div>
          </div>

          <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 gap-sm-3 pt-3 border-top">
            <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary rounded-pill px-4 text-center">Cancel</a>
            <button type="submit" class="btn-brand-solid px-5 text-center justify-content-center">
              <i class="fa-solid fa-check me-1"></i> Save Changes
            </button>
          </div>

        </form>
      </div>

    </div>
  </div>
</div>

<script>
  let activeObjectUrls = [];

  function revokeAllObjectUrls() {
    activeObjectUrls.forEach(url => URL.revokeObjectURL(url));
    activeObjectUrls = [];
  }

  function updateImagePreviews() {
    revokeAllObjectUrls();
    
    const imageInput = document.getElementById('image');
    const imageUrlInput = document.getElementById('imageUrl');
    const otherImagesInput = document.getElementById('otherImages');
    const otherImageUrlsInput = document.getElementById('otherImageUrls');
    
    const previewEmptyState = document.getElementById('previewEmptyState');
    const previewGrid = document.getElementById('previewGrid');
    const coverPreviewCol = document.getElementById('coverPreviewCol');
    const coverPreviewImg = document.getElementById('coverPreviewImg');
    const galleryPreviewList = document.getElementById('galleryPreviewList');
    const countBadge = document.getElementById('previewCountBadge');

    let coverSrc = null;
    if (imageInput.files && imageInput.files[0]) {
      coverSrc = URL.createObjectURL(imageInput.files[0]);
      activeObjectUrls.push(coverSrc);
    } else if (imageUrlInput && imageUrlInput.value.trim()) {
      coverSrc = imageUrlInput.value.trim();
    }

    if (coverSrc) {
      coverPreviewImg.src = coverSrc;
      coverPreviewCol.classList.remove('d-none');
    } else {
      coverPreviewImg.src = '';
      coverPreviewCol.classList.add('d-none');
    }

    galleryPreviewList.innerHTML = '';
    let galleryCount = 0;

    if (otherImagesInput.files && otherImagesInput.files.length > 0) {
      const files = Array.from(otherImagesInput.files).slice(0, 4);
      files.forEach((file, idx) => {
        galleryCount++;
        const blobUrl = URL.createObjectURL(file);
        activeObjectUrls.push(blobUrl);
        const col = document.createElement('div');
        col.className = 'col-6';
        col.innerHTML = `
          <div class="card h-100 border-0 shadow-sm overflow-hidden position-relative rounded-3" style="height: 85px;">
            <img src="${blobUrl}" class="w-100 h-100 object-fit-cover" alt="Gallery preview ${idx + 1}">
            <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 start-0 m-1 px-1.5 py-0.5 text-white" style="font-size:10px;">
              <i class="fa-solid fa-photo-film me-1"></i>#${idx + 1}
            </span>
          </div>
        `;
        galleryPreviewList.appendChild(col);
      });
    }

    if (otherImageUrlsInput && otherImageUrlsInput.value.trim()) {
      const urls = otherImageUrlsInput.value.split(',').map(u => u.trim()).filter(u => u.length > 0);
      urls.slice(0, 4 - galleryCount).forEach((url, idx) => {
        galleryCount++;
        const col = document.createElement('div');
        col.className = 'col-6';
        col.innerHTML = `
          <div class="card h-100 border-0 shadow-sm overflow-hidden position-relative rounded-3" style="height: 85px;">
            <img src="${url}" class="w-100 h-100 object-fit-cover" alt="Gallery preview" onerror="this.src='/images/placeholder.jpg'">
            <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 start-0 m-1 px-1.5 py-0.5 text-white" style="font-size:10px;">
              <i class="fa-solid fa-link me-1"></i>Link
            </span>
          </div>
        `;
        galleryPreviewList.appendChild(col);
      });
    }

    const totalImages = (coverSrc ? 1 : 0) + galleryCount;
    if (totalImages > 0) {
      previewEmptyState.classList.add('d-none');
      previewGrid.classList.remove('d-none');
      countBadge.textContent = `${totalImages} new photo${totalImages > 1 ? 's' : ''} ready`;
      countBadge.className = 'badge bg-success-subtle text-success border border-success-subtle';
    } else {
      previewEmptyState.classList.remove('d-none');
      previewGrid.classList.add('d-none');
      countBadge.textContent = 'No new images selected';
      countBadge.className = 'badge bg-secondary-subtle text-muted';
    }
  }

  function clearCoverPreview() {
    document.getElementById('image').value = '';
    if (document.getElementById('imageUrl')) document.getElementById('imageUrl').value = '';
    updateImagePreviews();
  }

  document.getElementById('image').addEventListener('change', updateImagePreviews);
  if (document.getElementById('imageUrl')) document.getElementById('imageUrl').addEventListener('input', updateImagePreviews);
  document.getElementById('otherImages').addEventListener('change', updateImagePreviews);
  if (document.getElementById('otherImageUrls')) document.getElementById('otherImageUrls').addEventListener('input', updateImagePreviews);
</script>
